# Configuración General del Microservicio
APP_ENV=development
APP_PORT=8000
API_KEY=datamind_api_secret_token_2026

# Motor Ollama Local
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60.0

# Base de Datos PostgreSQL + pgvector (Memoria y Vectores)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_rag
POSTGRES_POOL_SIZE=10

# Base de Datos Externa Opcional (Solo Lectura)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=readonly_user
MARIADB_PASSWORD=readonly_password
MARIADB_DB=analytics_db
MARIADB_MAX_ROWS=500
MARIADB_TIMEOUT_SECONDS=5.0

# Parámetros RAG
CHUNK_SIZE=600
CHUNK_OVERLAP=80
DATASET_CACHE_TTL_HOURS=2
